---
// src/pages/products.astro
import LayoutPages from '../layouts/layoutPages.astro';
import ProductCard from '../components/ProductCard.astro';
import { wixClient } from "../wix-client.ts"; // <-- Tu puente a Wix

// 1. Le pedimos a Wix TODO el catálogo de Salsas
const { items: listadoSalsas } = await wixClient.products.queryProducts().find();
---

<LayoutPages title="Nuestros Productos">
  <section class="max-w-300 mx-auto px-4 py-12">
    <header class="mb-12 text-center">
      <h1 class="text-4xl font-lora font-bold tracking-tight text-chocolate">Nuestros Sabores</h1>
      <p class="text-gray-500 mt-3 text-lg">Explora nuestra selección de salsas artesanales</p>
    </header>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      
      {listadoSalsas.length > 0 ? (
        listadoSalsas.map((salsa) => (
          <ProductCard product={salsa} />
        ))
      ) : (
        <p class="col-span-full text-center text-gray-500 py-10">
          Aún no hay salsas publicadas en la tienda.
        </p>
      )}

    </div>
  </section>
</LayoutPages>

<script>
  import { addToCart } from '../store/cartStore.js';

  // Le decimos a TypeScript que esto es una lista de Botones HTML
  const botones = document.querySelectorAll('.btn-agregar') as NodeListOf<HTMLButtonElement>;
  
  botones.forEach(boton => {
    boton.addEventListener('click', async () => {
      // Como ahora sabe que es un botón, nos dejará usar .disabled sin quejarse
      const id = boton.getAttribute('data-producto-id');
      const textoOriginal = boton.textContent;
      
      boton.textContent = 'Agregando...';
      boton.disabled = true;
      
      try {
        await addToCart(id);
        boton.textContent = '¡Agregado!';
        boton.classList.replace('bg-chocolate', 'bg-green-600');
        
        setTimeout(() => {
          boton.textContent = textoOriginal;
          boton.classList.replace('bg-green-600', 'bg-chocolate');
          boton.disabled = false;
        }, 1500);
      } catch (err) {
        boton.textContent = 'Error';
        boton.disabled = false;
      }
    });
  });
</script>