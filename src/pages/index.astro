---
import Layout from "../layouts/layout.astro";
import { wixClient } from "../wix-client";
---

<Layout title="RoRo's | Prepara tu Salsa">
    <section class="h-screen bg-[url('/banner-index.png')] bg-cover bg-center relative flex items-center justify-center">
        <div class="absolute inset-0 bg-black/25 flex items-center justify-center">
            <div class="text-center text-white flex flex-col items-center">
                <img src="/logo.png" alt="RoRo's Logo" class="max-w-55 mb-4 drop-shadow-lg" />
                <h1 class="font-satisfy text-6xl md:text-7xl font-bold mb-8 text-white drop-shadow-md">Prepara tu Salsa...!</h1>
                
                <div class="flex flex-col items-center mt-12 cursor-pointer hover:opacity-80 transition-opacity">
                    <span class="mb-3 text-lg font-medium tracking-wider uppercase">Ver Sabores</span>
                    <div class="w-6 h-6 border-b-2 border-r-2 border-white transform rotate-45"></div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-arena py-24">
        <div class="max-w-6xl mx-auto px-4">
            <h2 class="text-chocolate text-4xl font-serif text-center mb-16">Descubre RoRo's</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <a href="/products" class="relative h-80 rounded-xl overflow-hidden shadow-lg transform transition duration-400 hover:-translate-y-3 hover:shadow-2xl group">
                    <div class="absolute inset-0 bg-cover bg-center transition duration-700 group-hover:scale-110" style="background-image: url('/card-productos.png')"></div>
                    <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-8 text-white text-center flex flex-col items-center">
                        <h3 class="font-serif text-3xl font-bold mb-2">Sabores</h3>
                        <p class="opacity-90 mb-6 font-light">Explora nuestras bases artesanales</p>
                        <span class="inline-block px-6 py-2.5 border border-white text-white text-xs uppercase tracking-widest font-bold transition-all duration-300 group-hover:bg-white group-hover:text-chocolate">Ver Catálogo</span>
                    </div>
                </a>

                <a href="/about" class="relative h-80 rounded-xl overflow-hidden shadow-lg transform transition duration-400 hover:-translate-y-3 hover:shadow-2xl group">
                    <div class="absolute inset-0 bg-cover bg-center transition duration-700 group-hover:scale-110" style="background-image: url('/card-nosotros.png')"></div>
                    <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-8 text-white text-center flex flex-col items-center">
                        <h3 class="font-serif text-3xl font-bold mb-2">Nosotros</h3>
                        <p class="opacity-90 mb-6 font-light">Calidad desde el Km. 12</p>
                        <span class="inline-block px-6 py-2.5 border border-white text-white text-xs uppercase tracking-widest font-bold transition-all duration-300 group-hover:bg-white group-hover:text-chocolate">Conócenos</span>
                    </div>
                </a>

                <a href="/contact" class="relative h-80 rounded-xl overflow-hidden shadow-lg transform transition duration-400 hover:-translate-y-3 hover:shadow-2xl group">
                    <div class="absolute inset-0 bg-cover bg-center transition duration-700 group-hover:scale-110" style="background-image: url('/card-recetas.png')"></div>
                    <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/30 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-8 text-white text-center flex flex-col items-center">
                        <h3 class="font-serif text-3xl font-bold mb-2">Contacto</h3>
                        <p class="opacity-90 mb-6 font-light">Contacta con nosotros</p>
                        <span class="inline-block px-6 py-2.5 border border-white text-white text-xs uppercase tracking-widest font-bold transition-all duration-300 group-hover:bg-white group-hover:text-chocolate">Ver Recetas</span>
                    </div>
                </a>

            </div>
        </div>
    </section>
</Layout>