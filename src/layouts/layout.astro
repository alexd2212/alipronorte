---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/FooterPages.astro";
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Satisfy&family=Lora:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet" />
    <title>{title} | RoRo's Salsas Artesanales</title>
  </head>
  
  <body class="bg-white text-chocolate flex flex-col min-h-screen overflow-x-hidden">
    <Navbar />

    <main class="flex-1">
      <slot /> 
    </main>

    <Footer />
  </body>
</html>
